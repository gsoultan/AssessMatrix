# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me
AM_OWNER_PASSWORD=change-me-too
AM_APP_PASSWORD=change-me-three
# openssl rand -hex 32
AM_SECRET=
# Postgres on the host; change it if 5432 is taken by another Postgres.
# AM_PG_PORT=5433
# Local development: the dev mailbox shows invitation mail at /dev/mailbox.
AM_DEV=1
AM_MAILER=mailbox
AM_PUBLIC_URL=http://localhost:5180
# AM_RUNNER_URL=https://ujian.example.id   # the candidate runner on its own origin
# AM_WEBHOOK_ALLOW_PRIVATE=1   # let webhooks reach http://localhost receivers (needs AM_DEV=1)

# Production on one machine: `docker compose --profile tls up -d`.
# AM_DOMAIN=exam.example.id
# AM_RUNNER_DOMAIN=ujian.example.id         # optional; then AM_RUNNER_URL=https://ujian.example.id
# AM_PUBLIC_URL=https://exam.example.id
# AM_TRUST_PROXY=1
# AM_LIMIT_PER_IP=600         # an exam hall of ~150 candidates behind one address
# AM_DEV=0
# AM_MAILER=smtp
# AM_SMTP_ADDR=smtp.example.id:587          # STARTTLS is required
# AM_SMTP_FROM=AssessMatrix <noreply@example.id>
# AM_SMTP_USER=
# AM_SMTP_PASS=
# AM_BACKUP_KEEP=7            # nightly base backups `make backup` keeps on this machine

# Updates (docs/13 §2). The core looks for newer releases and shows super
# administrators; deploy/updater/update.sh, run every minute, applies one
# they ask for. It sets these two itself; leave them unset to build locally.
# AM_IMAGE=ghcr.io/gsoultan/assessmatrix@sha256:…
# AM_PSYCHOMETRICS_IMAGE=ghcr.io/gsoultan/assessmatrix-psychometrics@sha256:…
# AM_UPDATE_CHECK=off         # make no outbound calls; update by hand
# AM_UPDATE_VERIFY=1          # updater: check build provenance with the gh CLI first
# AM_UPDATE_READY_TIMEOUT=180 # updater: seconds the new version has to become ready
